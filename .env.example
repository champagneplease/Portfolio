# ==========================================
# Nacho Miranda Portfolio - Environment Variables
# ==========================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=portfolio_db
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/portfolio_db?schema=public"

# Backend (NestJS)
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Email Notifications (Resend API - free tier 3000 emails/mo)
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL="nachomirnd@gmail.com"
RESEND_FROM_EMAIL="Nacho Portfolio <onboarding@resend.dev>"

# Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

